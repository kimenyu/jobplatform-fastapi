# ===========================
# OpenAI
# ===========================
OPENAI_API_KEY=your_openai_api_key_here

# ===========================
# App Security
# ===========================
SECRET_KEY=your_secret_key_here

# ===========================
# Firebase
# ===========================
FIREBASE_CREDENTIALS_PATH=./credentials/your-firebase-service-account.json

# ===========================
# Google OAuth
# ===========================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ===========================
# PostgreSQL (Local Development)
# ===========================
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ===========================
# Database URL (Optional)
# ===========================
DATABASE_URL=postgresql+psycopg2://username:password@hostname:5432/database_name

# ===========================
# Redis
# ===========================
REDIS_URL=redis://localhost:6379/0

# Example (Cloud Redis)
# REDIS_URL=rediss://username:password@your-redis-host:6379

# Example CLI
# redis-cli -u redis://localhost:6379
